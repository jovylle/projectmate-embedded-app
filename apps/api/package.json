{
  "name": "@projectmate/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Cloudflare Worker API for ProjectMate issue ingestion and moderation.",
  "scripts": {
    "build": "tsc --noEmit",
    "dev": "wrangler dev src/index.ts",
    "deploy": "wrangler deploy src/index.ts",
    "d1:migrate": "wrangler d1 migrations apply PROJECTMATE_DB --local",
    "test": "vitest run",
    "check": "tsc --noEmit"
  },
  "dependencies": {
    "@projectmate/shared-types": "workspace:*"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260520.0",
    "typescript": "^5.8.3",
    "vitest": "^2.1.8",
    "wrangler": "^4.19.1"
  }
}
